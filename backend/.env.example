APP_NAME="Modal Sekolahnya Kalysa"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://profit.example.com
APP_TIMEZONE=Asia/Jakarta

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kalysa_profit
DB_USERNAME=kalysa_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
LOG_CHANNEL=single
LOG_LEVEL=warning

# Dipakai hanya saat php artisan db:seed --class=InitialUsersSeeder
# Ganti password produksi setelah deployment.
INITIAL_LOGIN_PASSWORD=
